{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lionbooking",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Without this, matching static files (e.g. admin/students.html) are
    // served directly by the Assets layer and never reach src/index.ts at
    // all — the session check there would be silently skipped.
    "run_worker_first": ["/admin*", "/teacher*", "/student*", "/email*", "/ui*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lionbooking",
      "database_id": "9130949e-5936-48d5-8c5e-491f2bf8759d",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "lionbooking-avatars"
    }
  ]
}

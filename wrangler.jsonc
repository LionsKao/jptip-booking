{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lionbooking",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Without this, matching static files (e.g. admin/students.html) are
    // served directly by the Assets layer and never reach src/index.ts at
    // all — the session check there would be silently skipped.
    "run_worker_first": ["/admin*", "/teacher*", "/student*", "/email*", "/ui*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lionbooking",
      "database_id": "9130949e-5936-48d5-8c5e-491f2bf8759d",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "lionbooking-avatars"
    }
  ],
  // Not secrets — tenant/client IDs and the sender mailbox are identifiers,
  // not credentials. The actual credential (MS_CLIENT_SECRET) is a Worker
  // secret instead (`wrangler secret put`), never committed here.
  "vars": {
    "MS_TENANT_ID": "f1aafcf0-78cb-42c9-93ec-c460da98aaaa",
    "MS_CLIENT_ID": "8cadde49-f29b-44cc-9c5c-4b8c99e8e6e5",
    "MS_SENDER_EMAIL": "flow@jptip.co.jp"
  }
}

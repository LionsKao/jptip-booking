{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lionbooking",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lionbooking",
      "database_id": "9130949e-5936-48d5-8c5e-491f2bf8759d",
      "migrations_dir": "migrations"
    }
  ]
}
